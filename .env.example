# Скопируй в .env и впиши свои ключи:  cp .env.example .env
# Обязательны: TELEGRAM_BOT_TOKEN, DEEPSEEK_API_KEY и хотя бы один поисковик
# (TAVILY_API_KEY / EXA_API_KEY / PERPLEXITY_API_KEY). Остальное — по желанию.

# ===== Telegram =====
# Токен бота от @BotFather. Бот должен быть админом канала с правом публикации.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@ai_free_tips
# Твой числовой chat_id (узнать у @userinfobot) — сюда бот шлёт ролики, отчёты и алерты.
OWNER_CHAT_ID=

# ===== DeepSeek: редактор + креативщик + сценарист =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Модель креативщика (по умолчанию = DEEPSEEK_MODEL)
# CREATIVE_MODEL=deepseek-chat
EDITOR_TEMPERATURE=0.2
CREATIVE_TEMPERATURE=0.85
ANTIREPEAT_LOOKBACK=10

# ===== Поиск: первый план — Tavily + Exa, Perplexity — резерв =====
TAVILY_API_KEY=
TAVILY_TOPIC=news
TAVILY_TIME_RANGE=month
TAVILY_MAX_RESULTS=10
TAVILY_SEARCH_DEPTH=advanced
EXA_API_KEY=
EXA_NUM_RESULTS=10
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
# Perplexity зовём, только если свежих источников от Tavily+Exa меньше порога
PERPLEXITY_FALLBACK_MIN_FRESH=12
FRESH_SOURCE_WINDOW_DAYS=21

# ===== Отбор =====
FRESH_DAYS=7
DEDUP_DAYS=30
POST_COUNT=5
# Дни недели (1=пн … 7=вс), когда дополнительно ищем гранты для ИИ-стартапов
GRANTS_WEEKDAYS=1,4

# ===== Расписание воркера =====
TIMEZONE=Europe/Kyiv
# Слоты добычи халяв в очередь (через запятую)
HARVEST_TIME=07:00,14:00
# Слоты публикации — сколько слотов, столько постов в день
PUBLISH_TIMES=10:00,19:00
# Слоты Shorts-роликов; пусто = видео-конвейер выключен
VIDEO_TIME=
QUEUE_TTL_DAYS=4
QUEUE_MAX=12

# ===== Видео-конвейер (Shorts) =====
# Бесплатный сток https://www.pexels.com/api/ — пусто = анимированный градиент
PEXELS_API_KEY=
VIDEO_VOICE=ru-RU-DmitryNeural
VIDEO_VOICE_EN=en-US-AndrewNeural
VIDEO_RATE=+10%
VIDEO_SCRIPT_TEMPERATURE=0.8
# false = тест-режим: ролик не идёт в канал, только тебе в личку с готовыми подписями
VIDEO_POST_TO_CHANNEL=true
# На слабом сервере ставь 540x960 или 720x1280
VIDEO_SIZE=1080x1920

# ===== Bluesky (пусто = выключено) =====
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ===== Юзербот: бот-поисковик, /report, /scout, комментинг =====
# Креды с https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка сессии — получить один раз: python login_userbot.py. Никому не показывай!
USERBOT_SESSION=
# false = комментинг выкл, бот-поисковик и команды работают
USERBOT_COMMENTING=true
USERBOT_DAILY_MAX=10
USERBOT_PER_CHANNEL_DAILY=1
USERBOT_MIN_DELAY_SEC=120
USERBOT_MAX_DELAY_SEC=600
USERBOT_REALTIME=true
USERBOT_IDLE_MINUTES=120
USERBOT_DIGEST_ON_START=false
COMMENT_DIGEST_TIME=
COMMENT_DIGEST_MAX=20
COMMENT_REPORT_TIME=22:30
COMMENT_TEMPERATURE=1.5
# Автопроверка каналов-доноров черновиками в личку, раз в N минут (0 = выкл)
COMMENT_CHECK_MINUTES=0

# ===== Надёжность HTTP =====
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF=2.0
